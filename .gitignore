# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Local data produced by the archiver (compliance archive, never committed)
data/
*.jsonl

# Secrets: never commit them (kubeconfig, env files, keys, Terraform state)
.env
.env.*
*.pem
*.key
kubeconfig*
# kubeconfig written by the Terraform kind provider (contains the cluster's client key)
terraform/*-config
*.tfstate
*.tfstate.*
.terraform/

# MCP ops agent audit trail (local, may contain operator questions)
audit.log

# OS / editors
.DS_Store
.idea/
.vscode/
